---
import KuboIcon from '../ui/KuboIcon.astro';
import StatusBadge from './StatusBadge.astro';
import { recentOrders } from '../../data/admin/dashboard.mock';
import { withBase } from '../../lib/url';

function detailFor(order: (typeof recentOrders)[number]) {
  return JSON.stringify({
    eyebrow: 'PEDIDO',
    title: order.id,
    badge: { tone: order.tone, label: order.status },
    fields: [
      { label: 'Cliente', value: order.client },
      { label: 'Total', value: order.total },
      { label: 'Estado', value: order.status },
    ],
    actionHref: withBase('/admin/comercio/pedidos/'),
    actionLabel: 'Ver todos los pedidos',
  });
}
---

<article class="panel panel-orders">
  <header class="panel-header">
    <div>
      <h2>Pedidos recientes</h2>
    </div>
    <a class="text-link" href={withBase('/admin/comercio/pedidos/')}>Ver todos <KuboIcon name="nav-arrow-right" size={14} /></a>
  </header>

  <div class="table-shell desktop-table">
    <table>
      <caption class="sr-only">Pedidos recientes de la tienda, con cliente, total y estado.</caption>
      <thead>
        <tr>
          <th scope="col">PEDIDO</th>
          <th scope="col">CLIENTE</th>
          <th scope="col">TOTAL</th>
          <th scope="col">ESTADO</th>
          <th scope="col"><span class="sr-only">Acciones</span></th>
        </tr>
      </thead>
      <tbody>
        {recentOrders.map((order) => (
          <tr>
            <td><strong class="mono-strong">{order.id}</strong></td>
            <td>{order.client}</td>
            <td>{order.total}</td>
            <td><StatusBadge tone={order.tone} label={order.status} /></td>
            <td>
              <button
                class="row-action"
                type="button"
                data-detail-trigger
                data-detail={detailFor(order)}
                aria-label={`Ver detalle de ${order.id}`}
              >
                <KuboIcon name="nav-arrow-right" size={16} />
              </button>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="mobile-list mobile-only">
    {recentOrders.map((order) => (
      <button class="mobile-data-card" type="button" data-detail-trigger data-detail={detailFor(order)}>
        <div>
          <strong class="mono-strong">{order.id}</strong>
          <span>{order.client}</span>
        </div>
        <div class="mobile-card-right">
          <strong>{order.total}</strong>
          <StatusBadge tone={order.tone} label={order.status} />
        </div>
      </button>
    ))}
  </div>
</article>
