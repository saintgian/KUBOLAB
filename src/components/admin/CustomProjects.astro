---
import KuboIcon from '../ui/KuboIcon.astro';
import StatusBadge from './StatusBadge.astro';
import { customProjects } from '../../data/admin/dashboard.mock';

function detailFor(project: (typeof customProjects)[number]) {
  return JSON.stringify({
    eyebrow: 'PROYECTO CUSTOM',
    title: project.project,
    badge: { tone: project.tone, label: project.phase },
    fields: [
      { label: 'Cliente', value: project.client },
      { label: 'Fase', value: project.phase },
      { label: 'Fecha límite', value: project.due },
    ],
    actionHref: '/admin/custom/proyectos/',
    actionLabel: 'Ver proyectos',
  });
}
---

<article class="panel panel-custom reveal" style="--delay: 240ms">
  <header class="panel-header">
    <div>
      <h2>Proyectos activos</h2>
    </div>
    <a class="text-link" href="/admin/custom/proyectos/">Ver todos <KuboIcon name="nav-arrow-right" size={14} /></a>
  </header>

  <div class="custom-list">
    {customProjects.map((project) => (
      <button
        class="custom-row"
        type="button"
        data-detail-trigger
        data-detail={detailFor(project)}
        aria-label={`Ver detalle de ${project.project}`}
      >
        <span class="custom-symbol" aria-hidden="true"><KuboIcon name="cube" size={17} /></span>
        <span class="custom-main">
          <strong>{project.project}</strong>
          <span>{project.client}</span>
        </span>
        <StatusBadge tone={project.tone} label={project.phase} />
        <span class="custom-due">{project.due}</span>
      </button>
    ))}
  </div>
</article>
