---
import KuboIcon from '../ui/KuboIcon.astro';
import StatusBadge from './StatusBadge.astro';
import { productionQueue } from '../../data/admin/dashboard.mock';

function detailFor(job: (typeof productionQueue)[number]) {
  return JSON.stringify({
    eyebrow: 'PRODUCCIÓN',
    title: job.item,
    badge: { tone: job.tone, label: job.status },
    fields: [
      { label: 'Origen', value: job.origin },
      { label: 'Estado', value: job.status },
      { label: 'Cantidad', value: job.qty },
      { label: 'Material', value: job.material },
    ],
    actionHref: '/admin/produccion/cola/',
    actionLabel: 'Abrir cola',
  });
}
---

<article class="panel panel-production">
  <header class="panel-header">
    <div>
      <h2>Producción próxima</h2>
    </div>
    <a class="text-link" href="/admin/produccion/cola/">Abrir cola <KuboIcon name="nav-arrow-right" size={14} /></a>
  </header>

  <div class="production-list">
    {productionQueue.map((job, index) => (
      <button
        class="production-row"
        type="button"
        data-detail-trigger
        data-detail={detailFor(job)}
        aria-label={`Ver detalle de ${job.item}`}
      >
        <span class="production-index">{String(index + 1).padStart(2, '0')}</span>
        <span class="production-main">
          <strong>{job.item}</strong>
          <span>{job.origin}</span>
        </span>
        <span class="production-tech">
          <span>{job.qty}</span>
          <span>{job.material}</span>
          <span>{job.time}</span>
        </span>
        <StatusBadge tone={job.tone} label={job.status} />
      </button>
    ))}
  </div>
</article>
